{"$id":"https://justinahiggins614-cmyk.github.io/signature-ai-image-video-maker/data/schemas/video.schema.json","$schema":"http://json-schema.org/draft-07/schema#","description":"One video creative. Videos are live canvas animations rendered on-device; the exported .webm is the recorded file. Same prompt + settings + engine version + seed => same animation.","properties":{"ad_id":{"description":"Parent ad, if this is an ad creative","pattern":"^JAH-AD-\\d{6}$","type":"string"},"aspect_ratio":{"type":"string"},"audio_status":{"default":"silent","enum":["silent"],"type":"string"},"canonical_url":{"type":"string"},"content_hash":{"description":"SHA-256 of exported file, when exported","type":"string"},"engine_version":{"default":"SIGART-V1","type":"string"},"export":{"properties":{"browser":{"type":"string"},"codec":{"default":"vp8/vp9","type":"string"},"format":{"default":"webm","enum":["webm"]},"status":{"enum":["EXPORTED","NOT EXPORTED"]}},"type":"object"},"frame_rate":{"type":"number"},"frames":{"type":"integer"},"height":{"type":"integer"},"length_seconds":{"type":"number"},"live_animation":{"default":true,"description":"Rendered live on canvas; the file is the export","type":"boolean"},"normalized_prompt":{"type":"string"},"original_prompt":{"type":"string"},"seed":{"type":"integer"},"seed_algorithm":{"default":"xfnv1a","type":"string"},"status":{"enum":["PLANNED","RENDERED","EXPORTED"],"type":"string"},"style":{"type":"string"},"video_id":{"description":"Permanent video ID, never reused","pattern":"^JAH-PIXEL-VIDEO-\\d{6}$","type":"string"},"width":{"type":"integer"}},"required":["video_id","original_prompt","engine_version","seed","status"],"title":"JAH-PIXEL-VIDEO-RECORD/1.0 — Signature AI Pixel video","type":"object"}