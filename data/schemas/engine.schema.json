{"$id":"https://justinahiggins614-cmyk.github.io/signature-ai-image-video-maker/data/schemas/engine.schema.json","$schema":"http://json-schema.org/draft-07/schema#","description":"SigArt engine release record. Engine versions are immutable: SIGART-V1 behavior is preserved forever; changes ship as a new version.","properties":{"capabilities":{"items":{"type":"string"},"type":"array"},"dependencies":{"default":[],"description":"No runtime dependencies","type":"array"},"deterministic":{"default":true,"type":"boolean"},"engine_version":{"description":"Immutable engine version, e.g. SIGART-V1","pattern":"^SIGART-V\\d+$","type":"string"},"js_sha256":{"type":"string"},"js_url":{"type":"string"},"offline_capable":{"default":true,"type":"boolean"},"palettes":{"properties":{"count":{"type":"integer"},"version":{"type":"string"}},"type":"object"},"py_sha256":{"type":"string"},"py_url":{"type":"string"},"release_date":{"type":"string"},"runtimes":{"items":{"type":"string"},"type":"array"},"seed_algorithm":{"default":"xfnv1a -> mulberry32","type":"string"},"styles":{"properties":{"count":{"type":"integer"},"version":{"type":"string"}},"type":"object"}},"required":["engine_version","js_sha256","py_sha256","deterministic"],"title":"SIGART-ENGINE/1.0 — engine release record","type":"object"}